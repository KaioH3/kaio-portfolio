# Template - DO NOT use directly.
# Generated by scripts/vps-setup.sh with correct User/paths substituted.
#
[Unit]
Description=Kaio Portfolio - ML Engineer FastAPI
After=network.target
Wants=network.target

[Service]
Type=simple
User=__VPS_USER__
Group=__VPS_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --no-access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__APP_DIR__/data __APP_DIR__/logs

# Resource limits (adjust for your server RAM)
MemoryMax=1500M
CPUQuota=90%

[Install]
WantedBy=multi-user.target
