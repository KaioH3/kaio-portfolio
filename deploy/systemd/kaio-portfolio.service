[Unit]
Description=Kaio Portfolio - ML Engineer FastAPI
After=network.target
Wants=network.target

[Service]
Type=simple
User=aikadmin
Group=aikadmin
WorkingDirectory=/home/aikadmin/kaio-portfolio
EnvironmentFile=/home/aikadmin/kaio-portfolio/.env
ExecStart=/home/aikadmin/kaio-portfolio/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --no-access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/aikadmin/kaio-portfolio/data /home/aikadmin/kaio-portfolio/logs

# Resource limits (CX11: 2GB RAM)
MemoryMax=1500M
CPUQuota=90%

[Install]
WantedBy=multi-user.target
