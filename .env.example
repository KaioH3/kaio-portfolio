# Application
APP_NAME="Kaio Portfolio - ML Engineer"
ENV="development"  # development | production | staging
BASE_URL="http://localhost:8000"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security
ALLOWED_ORIGINS="http://localhost:8000,https://kaio.ia.br"
RATE_LIMIT=100  # requests per minute

# Logging
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"  # json | text

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=""  # Optional

# Database (if needed)
DATABASE_URL="sqlite:///./portfolio.db"

# External APIs for Projects
OPENAI_API_KEY=""
COHERE_API_KEY=""
VOYAGE_API_KEY=""

# RAG System Config
RAG_EMBEDDING_MODEL="voyage-3"
RAG_LLM_MODEL="gpt-4o-mini"
RAG_VECTOR_DB="qdrant"
RAG_VECTOR_DB_URL="http://localhost:6333"

# Credit Risk Model
CREDIT_MODEL_PATH="./models/xgboost_credit.pkl"
CREDIT_THRESHOLD=0.7
