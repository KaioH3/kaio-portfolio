# Application
APP_NAME="Kaio Portfolio - ML Engineer"
ENV="development"  # development | production | staging
BASE_URL="http://localhost:8000"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security
ALLOWED_ORIGINS="http://localhost:8000,https://kaio.ia.br"
RATE_LIMIT=100  # requests per minute

# Logging
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"  # json | text

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=""  # Optional

# LLM Providers (fallback chain: Groq -> Perplexity -> OpenAI)
LLM_PROVIDER="groq"  # groq | perplexity | openai
GROQ_API_KEY=""
PERPLEXITY_API_KEY=""
OPENAI_API_KEY=""

# Voyage AI (Embeddings)
VOYAGE_API_KEY=""  # Free tier: 200M tokens one-time
VOYAGE_MODEL="voyage-3-lite"

# Qdrant Cloud (Vector Database)
QDRANT_URL=""  # https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=""  # Free tier: 1GB storage

# RAG System Config
RATE_LIMIT_MONTHLY=15  # queries per IP per month

# Landing Page Config
CHECKOUT_URL="https://pay.hotmart.com/YOUR_LINK_HERE"
WHATSAPP_NUMBER="5511999999999"
SUPPORT_EMAIL="contato@example.com"

# Analytics (GoatCounter - Privacy-friendly)
GOATCOUNTER_CODE=""  # Your goatcounter.com site code (optional)
