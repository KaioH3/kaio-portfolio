# Application
APP_NAME="Kaio Portfolio - ML Engineer"
ENV="development"  # development | production | staging
BASE_URL="http://localhost:8000"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security
ALLOWED_ORIGINS="http://localhost:8000,https://kaio.ia.br"
RATE_LIMIT=100  # requests per minute

# Logging
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"  # json | text

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=""  # Optional

# LLM Providers (fallback chain: Groq -> Perplexity -> OpenAI)
LLM_PROVIDER="groq"  # groq | perplexity | openai
GROQ_API_KEY=""
PERPLEXITY_API_KEY=""
OPENAI_API_KEY=""

# RAG System Config
RAG_EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
RATE_LIMIT_MONTHLY=15  # queries per IP per month
